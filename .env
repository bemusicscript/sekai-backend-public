APP_VERSION=2026.5.2
WATCHTOWER_VERSION=1.7.1

# https://github.com/caddyserver/caddy/releases
CADDY_VERSION=2.11.3
# https://github.com/envoyproxy/envoy/releases
PROXY_VERSION=v1.38-latest
# https://hub.docker.com/_/mariadb
# https://mariadb.org/mariadb/all-releases/
MARIADB_VERSION=12.2.2
# https://hub.docker.com/r/valkey/valkey/
VALKEY_VERSION=9.0.4-alpine
# https://hub.docker.com/_/python
PYTHON_VERSION=3.14.5-slim
# https://github.com/astral-sh/uv/pkgs/container/uv
UV_VERSION=0.11.13
# https://github.com/bazelbuild/bazelisk/releases/tag/v1.28.1
BAZEL_VERSION=v1.28.1
# https://hub.docker.com/r/trafex/php-nginx/tags
PHP_VERSION=3.11.1

# MariaDB
MARIADB_ROOT_HOST=gateway.internal
MARIADB_ROOT_PASSWORD=sekai
MARIADB_DATABASE=sekai
MARIADB_USER=sekai
MARIADB_PASSWORD=sekai
MARIADB_AUTO_UPGRADE=1
TZ=Asia/Tokyo

# Cloudflare tunneling
CLOUDFLARED_TOKEN=fixme
DISCORD_WEBHOOK_URL=fixme

# Cloudflare WARP
GOST_VERSION=2.12.0
TARGETPLATFORM=linux/amd64
